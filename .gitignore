# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment & secrets — never commit real values (templates use *.env.example)
.env
*.env
!*.env.example
data/secrets/
*.pem
*.key
*.pfx
.tmp-electron-package/
# SQLite scratch files from local verify/backup scripts (not real app data)
.tmp-*.db
.tmp-*.db-shm
.tmp-*.db-wal

# Database files — NEVER commit real business data
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
# Migration import staging — keep the folder, never its data
import/*
!import/.gitkeep

# Playwright
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/
backend/webapp/assets/
.vs/
release/
