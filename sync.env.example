# Copy to C:\NEXOR ERP\sync.env on CITY SERVER and every SHOP CLIENT PC.
# Must match on both sides when client-ingest security is enabled.

# City server: set the same value in C:\NEXOR ERP\database.env (optional) or here.
# Shop clients: this file only (clients do not use database.env).
NEXOR_CLIENT_SYNC_API_KEY=generate_a_long_random_hex_key_here

# Phase B1 — save sales to C:\NEXOR ERP\data\client.db before syncing to city server
NEXOR_OFFLINE_FIRST=true

# Phase B2 — AGT submit from shop PC (optional; city server can also submit after sync)
# Without AGT_API_URL, submissions are simulated for testing.
# AGT_API_URL=https://agt.example.ao/api/invoices
# AGT_API_KEY=your_agt_key
# AGT_SIMULATE=false

# Optional — city server URL override for shop flush worker
# NEXOR_CITY_API_URL=http://192.168.10.1:3000
