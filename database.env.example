# Copy to C:\NEXOR ERP\database.env on the SERVER PC only.
# When this file exists with DATABASE_URL set, NEXOR uses PostgreSQL (not erp.db).
# Clients keep C:\NEXOR ERP\IP with only the server LAN IP — no database.env on clients.

DB_ENGINE=postgres
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@127.0.0.1:5432/kwanza_erp

# Optional — match docker-compose POSTGRES_PASSWORD
# POSTGRES_PASSWORD=your_secure_password

# --- Phase B sync (city server / HQ) ---
# Shop clients → city server ingest (see sync.env.example)
# NEXOR_CLIENT_SYNC_API_KEY=your_shared_shop_key

# City server → HQ ingest
# NEXOR_MAIN_API_URL=https://hq.example.com:3000
# NEXOR_SYNC_API_KEY=key_issued_by_hq

# Installation role override (usually set via Setup / installations table)
# NEXOR_INSTALLATION_ROLE=city_server

# AGT production API (city server signs/transmits)
# AGT_API_URL=https://agt.example.ao/api/invoices
# AGT_API_KEY=your_agt_key
# AGT_SIMULATE=false
