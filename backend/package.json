{
  "name": "nexor-erp-backend",
  "version": "1.1.147",
  "description": "NEXOR ERP Backend Server - SQLite + Express",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node src/migrations/run.js",
    "ensure-schema": "node scripts/ensure-server-schema.js",
    "seed:suppliers": "node scripts/seed-two-suppliers.js",
    "test": "node ../scripts/run-backend-tests.mjs",
    "test:node": "node --test test/**/*.test.js",
    "test:engine": "node ../scripts/run-backend-tests.mjs",
    "test:backup": "node ../scripts/run-backend-tests.mjs",
    "check:integrity": "node ../scripts/run-consistency-check.mjs --unique-only",
    "check:consistency": "node ../scripts/run-consistency-check.mjs",
    "repair:consistency": "node ../scripts/run-repair-consistency.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.9.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fast-xml-parser": "^5.8.0",
    "jsonwebtoken": "^9.0.2",
    "node-forge": "^1.4.0",
    "pg": "^8.20.0",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
