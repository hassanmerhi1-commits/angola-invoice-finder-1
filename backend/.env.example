# Copy this file to backend/.env (never commit .env).
# Load order: server.js calls dotenv before opening the DB.

# ---------------------------------------------------------------------------
# Option A — PostgreSQL (Docker in repo root: docker compose up -d postgres)
# ---------------------------------------------------------------------------
# Default DB name/user match docker-compose.yml (password default: yel3an7azi).
# DATABASE_URL=postgres://postgres:yel3an7azi@127.0.0.1:5432/kwanza_erp
# DB_ENGINE=postgres
#
# Then from backend/:
#   npm run migrate
#   npm start
#
# Note: POST /api/products/batch is SQLite-only; use single POST /api/products on Postgres.

# ---------------------------------------------------------------------------
# Option B — SQLite file (default when DATABASE_URL is unset)
# ---------------------------------------------------------------------------
# SQLITE_PATH=C:\nexor\erp.db

PORT=3000
